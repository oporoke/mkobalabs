# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://myapp:CHANGE_ME@localhost:5432/mkoba
DATABASE_SSL=false            # true only for a remote DB (certificate is verified)
WHATSAPP_TOKEN=               # System User token, expiration "Never"
WHATSAPP_PHONE_NUMBER_ID=     # Business number's phone_number_id
WEBHOOK_VERIFY_TOKEN=         # Any string; must match Meta webhook settings
META_APP_SECRET=              # App settings > Basic > App secret
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://mkoba.digital   # used in dashboard, statement and privacy links
ADMIN_PASSWORD=               # /admin password (user: admin); page disabled if empty
PRIVACY_CONTACT=              # shown on /faragha and /privacy
DATA_LOCATION=                # server country, English (e.g. Germany)
DATA_LOCATION_SW=             # server country, Swahili (e.g. Ujerumani)
LOG_LEVEL=info                # debug | info | warn | error
REPORT_TEMPLATE=mkoba_muhtasari    # approved WhatsApp template for evening reports
REPORT_TEMPLATE_LANG=sw
